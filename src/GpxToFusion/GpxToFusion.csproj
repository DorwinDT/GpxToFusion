<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Version and product info: shown in Help → About and in the exe's file properties. -->
    <Version>1.0.0</Version>
    <Product>GPX → Fusion</Product>
    <Authors>Peter Turcan (DorwinDT)</Authors>
    <Copyright>© 2026 Peter Turcan (DorwinDT)</Copyright>
    <Description>Turns a GPX track into a map background and an animatable Fusion polyline for DaVinci Resolve.</Description>
    <RepositoryUrl>https://github.com/DorwinDT/GpxToFusion</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GpxToFusion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.154.0" />
  </ItemGroup>

</Project>